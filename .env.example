# Diet_Mobile_app (Create React App) - environment template
# Copy to ".env.development" / ".env.production" (or ".env"). Only variables that
# start with REACT_APP_ reach the browser, so NEVER put secrets here.
# Every value is optional: when unset, the default in src/Views/Constant/Static.js
# is used (currently the hospital LAN addresses over plain http).
# Use https:// URLs for production so passwords and payment data are not sent in clear text.

# Meliora_API base URL (include /api)
REACT_APP_API_URL=http://localhost:7000/api
# socket.io address (same host/port as the API, without /api)
REACT_APP_WS_URL=http://localhost:7000
# Ellider API base URL
REACT_APP_ELLIDER_API_URL=http://localhost:6001/api
# KMC API base URL
REACT_APP_API_URL_KMC=http://localhost:5001/api
